{
  "name": "medusa-next",
  "version": "2.0.0",
  "private": true,
  "author": "Kasper Fabricius Kristensen <kasper@medusajs.com> & Victor Gerbrands <victor@medusajs.com> (https://www.medusajs.com)",
  "description": "Next.js Starter to be used with Medusa V2",
  "keywords": [
    "medusa-storefront"
  ],
  "scripts": {
    "dev": "next dev -p 8000",
    "build": "next build",
    "start": "next start -p 8000",
    "analyze": "ANALYZE=true next build",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f medusa",
    "docker:seed": "docker compose exec medusa npx medusa exec ./src/scripts/seed.ts",
    "docker:user": "docker compose exec medusa npx medusa user -e admin@medusa-test.com -p supersecret"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@headlessui/react": "^2.2.0",
    "@medusajs/js-sdk": "latest",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.511.0",
    "next": "^16.2.2",
    "pg": "^8.11.3",
    "qs": "^6.12.1",
    "react": "^19.2.1",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.2.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@medusajs/types": "latest",
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4.14.195",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ansi-colors": "^4.1.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5.3.2"
  },
  "packageManager": "yarn@4.12.0"
}
